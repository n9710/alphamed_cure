# ──────────────────────────────────────────────────────
# Alphamed Cure — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ──────────────────────────────────────────────────────

# ── Database (Supabase — use the POOLER/Transaction connection string for Vercel) ──
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for Prisma migrations (not pooled)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.supabase.com:5432/postgres"

# ── iron-session secret (generate with: openssl rand -base64 32) ──
SESSION_SECRET="replace-with-at-least-32-random-characters"

# ── Resend (transactional email) ──
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_NAME="Alphamed Cure"
RESEND_FROM_EMAIL="noreply@alphamedcure.com"
RESEND_ADMIN_EMAIL="procurement@alphamedcure.com"

# ── PostHog (public key is safe to expose; host is public) ──
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── App URLs ──
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Initial Admin Seed (used ONLY by prisma/seed.js, never at runtime) ──
ADMIN_EMAIL="admin@alphamedcure.com"
ADMIN_PASSWORD="ChangeMeNow!2024"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="Alphamed"
